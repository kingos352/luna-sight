# Copy to .env for local use. Never commit credentials.
LUNA_SIGHT_DATA_DIR=./data/cache
LUNA_SIGHT_LOG_LEVEL=INFO

# Gerçek görüntü çağrısıyla doğrulanan NVIDIA görsel modeli (2026-11-15).
LUNA_SIGHT_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
LUNA_SIGHT_NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LUNA_SIGHT_NIM_REASONING_EFFORT=none
NVIDIA_API_KEY=
LUNA_SIGHT_DEM_DIR=./data/cache/lola

# Yerel/harici Cosmos3 NIM alternatifi. Sunucunun model adını doğrulayın.
# LUNA_SIGHT_NIM_BASE_URL=http://127.0.0.1:8000/v1
# LUNA_SIGHT_NIM_MODEL=nvidia/cosmos3-nano-reasoner
# LUNA_SIGHT_NIM_REASONING_EFFORT=
# Cosmos Reason2 barındırılan API'si canlı denemede HTTP 404 döndürdü.

